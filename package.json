{
  "name": "epstein-files",
  "version": "1.0.0",
  "description": "Searchable archive of DOJ Epstein case documents. All documents sourced from [justice.gov/epstein](https://www.justice.gov/epstein).",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "bun test",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:api": "python3 stress_test.py",
    "test:all": "bun test && python3 -m unittest discover -s tests -v && python3 stress_test.py",
    "deploy:worker": "bunx wrangler deploy",
    "deploy:pages": "wrangler --cwd frontend pages deploy . --project-name=epstein"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/rillow/epstein-files.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "wrangler": "4.112.0"
  }
}
