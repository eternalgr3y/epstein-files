{
  "name": "epstein-files",
  "version": "1.0.0",
  "description": "Searchable archive of DOJ Epstein case documents. All documents sourced from [justice.gov/epstein](https://www.justice.gov/epstein).",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "bun test",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:api": "python3 stress_test.py",
    "test:all": "bun test && python3 -m unittest discover -s tests -v && python3 stress_test.py",
    "qa:production": "python production_smoke.py",
    "qa:canonicals": "python crawl_canonical_pages.py",
    "qa:integrity": "python audit_archive_integrity.py",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "node scripts/deploy-pages-production.mjs",
    "qa:release": "node scripts/deploy-pages-production.mjs --smoke-only"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eternalgr3y/epstein-files.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "wrangler": "4.122.0"
  }
}
