# Epstein Files Configuration
# Copy to .env and customize

# Domain
DOMAIN=epsteinfiles.org
ALLOWED_ORIGINS=https://epsteinfiles.org,https://www.epsteinfiles.org

# Email for Let's Encrypt SSL
CERTBOT_EMAIL=your-email@example.com

# OCR policy: warn indexes source content and logs redaction findings; block
# requires review; off skips redaction inspection.
REDACTION_POLICY=warn
OCR_PAGE_BATCH_SIZE=10
