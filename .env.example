# Epstein Files Configuration
# Copy to .env and customize for production

# =============================================================================
# REQUIRED
# =============================================================================

# Domain (used for CORS and SSL)
DOMAIN=epsteinfiles.org

# CORS allowed origins (comma-separated, NO wildcards in production!)
ALLOWED_ORIGINS=https://epsteinfiles.org,https://www.epsteinfiles.org

# Email for Let's Encrypt SSL certificates
CERTBOT_EMAIL=your-email@example.com

# =============================================================================
# SECURITY
# =============================================================================

# Rate limiting (requests per minute for search endpoints)
RATE_LIMIT_SEARCH=30

# Rate limiting (requests per minute for general API)
RATE_LIMIT_API=60

# Abuse detection: violations before IP is blocked
ABUSE_BLOCK_THRESHOLD=10

# Abuse detection: block duration in minutes
ABUSE_BLOCK_DURATION=60

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================

# Database path (default: ./database/epstein_files.db)
# DATABASE_PATH=/app/database/epstein_files.db

# =============================================================================
# OPTIONAL
# =============================================================================

# Admin API key for security stats endpoint (generate with: openssl rand -hex 32)
# ADMIN_API_KEY=your-secret-key-here

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Enable debug mode (NEVER in production!)
# DEBUG=false
