/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'sha256-1CbNvAnbFvodEYF8kmpxkVJzMNe804+i/oWZQqCnVnI=' 'sha256-ivc3fMWgal8RMRSPulvXNnCcjF4Wy1vhY4J0yJmJ/3w=' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The executable asset uses its content hash in the URL. _redirects maps that
# unique public path to the maintained app.js source file. Pages does not
# reliably vary its static-asset cache by query string, so a physical URL path
# change is required for every build.
/app-*.js
  Cache-Control: public, max-age=31536000, immutable

/static/app-*.css
  Cache-Control: public, max-age=31536000, immutable

# Icons and the social card change essentially never, and are referenced by
# fixed paths. A year of browser cache costs nothing; replacing one means
# renaming it or purging the cache.
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-64.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-180.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/og-image.png
  Cache-Control: public, max-age=31536000, immutable
